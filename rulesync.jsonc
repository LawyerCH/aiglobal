{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "global": true,
  "features": ["rules", "skills"],
  "targets": ["opencode", "claudecode", "copilot"],
  "delete": false,
  "verbose": false

  // 想借鉴社区规则/技能时，取消下面注释（要求对方仓库按 rules/ 或 skills/ 目录组织）：
  // 之后运行：cd ~/.aiglobal && rulesync install && rulesync generate
  // "sources": [
  //   { "source": "owner/repo", "rules": ["*"] },       // 拉取该仓库 rules/ 下全部规则
  //   { "source": "owner/repo", "skills": ["name"] }    // 拉取指定技能
  // ]
}
